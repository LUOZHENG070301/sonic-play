# 服务端口
PORT=3000

# 环境模式
NODE_ENV=development

# JWT 密钥（生产环境请使用强密码）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# CORS 允许的前端地址
CORS_ORIGIN=http://localhost:5173

# Supabase 配置（后续接入）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI 服务配置（后续接入）
OPENAI_API_KEY=
