# 环境变量配置文件
# 复制此文件为 .env 并根据实际情况修改

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# GPU 配置
DEVICE=cuda
GPU_ID=0

# 日志级别
LOG_LEVEL=INFO

# 任务配置
MAX_CONCURRENT_TASKS=2
TASK_CACHE_TTL=3600

# 文件配置
MAX_FILE_SIZE=524288000
OUTPUT_DIR=./output
UPLOAD_DIR=./uploads

# 分离配置
DEFAULT_SEPARATION_MODEL=htdemucs
DEFAULT_SHIFTS=2
DEFAULT_OVERLAP=0.25

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
